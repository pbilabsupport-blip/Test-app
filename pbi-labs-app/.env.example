# Copy to .env for local Netlify dev. Never commit .env.
# Put the same keys in the Netlify UI. Anything starting with REACT_APP_
# is baked into the public website. Do not put private keys on those names.

# Public — safe in the browser
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_GUMROAD_URL=https://your-product.gumroad.com/l/your-product
REACT_APP_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
REACT_APP_ADSENSE_SLOT_BANNER=
REACT_APP_ADSENSE_SLOT_CARD=
REACT_APP_VAPID_PUBLIC_KEY=

# Server only — Netlify function env, never REACT_APP_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GUMROAD_PRODUCT_PERMALINK=
GUMROAD_WEBHOOK_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
OTP_PEPPER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
